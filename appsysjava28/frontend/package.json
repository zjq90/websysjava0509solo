{
  "name": "medical-appointment-app",
  "version": "1.0.0",
  "description": "医疗预约挂号系统",
  "main": "main.js",
  "scripts": {
    "serve": "npm run dev:h5",
    "build": "npm run build:h5",
    "dev:h5": "cross-env NODE_ENV=development UNI_PLATFORM=h5 vue-cli-service uni-serve",
    "build:h5": "cross-env NODE_ENV=production UNI_PLATFORM=h5 vue-cli-service uni-build",
    "dev:mp-weixin": "cross-env NODE_ENV=development UNI_PLATFORM=mp-weixin vue-cli-service uni-build --watch",
    "build:mp-weixin": "cross-env NODE_ENV=production UNI_PLATFORM=mp-weixin vue-cli-service uni-build"
  },
  "dependencies": {
    "@dcloudio/uni-app": "^2.0.2-4020920240402001",
    "@dcloudio/uni-app-plus": "^2.0.2-4020920240402001",
    "@dcloudio/uni-components": "^2.0.2-4020920240402001",
    "@dcloudio/uni-h5": "^2.0.2-4020920240402001",
    "@dcloudio/uni-mp-weixin": "^2.0.2-4020920240402001",
    "@dcloudio/uni-stat": "^2.0.2-4020920240402001",
    "core-js": "^3.8.3",
    "vue": "^2.6.14"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "^2.0.2-4020920240402001",
    "@dcloudio/uni-cli-shared": "^2.0.2-4020920240402001",
    "@dcloudio/uni-template-compiler": "^2.0.2-4020920240402001",
    "@dcloudio/vue-cli-plugin-hbuilderx": "^2.0.2-4020920240402001",
    "@dcloudio/vue-cli-plugin-uni": "^2.0.2-4020920240402001",
    "@dcloudio/vue-cli-plugin-uni-optimize": "^2.0.2-4020920240402001",
    "@dcloudio/webpack-uni-mp-loader": "^2.0.2-4020920240402001",
    "@dcloudio/webpack-uni-pages-loader": "^2.0.2-4020920240402001",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "babel-plugin-import": "^1.13.3",
    "cross-env": "^7.0.3",
    "postcss-comment": "^2.0.0",
    "sass": "^1.50.0",
    "sass-loader": "^10.2.1",
    "vue-template-compiler": "^2.6.14"
  },
  "browserslist": [
    "Android >= 4.4",
    "ios >= 9"
