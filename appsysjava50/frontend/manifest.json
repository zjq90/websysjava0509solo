{
  "name": "二手交易",
  "appid": "__UNI__SECONDHAND",
  "description": "二手交易系统小程序",
  "versionName": "1.0.0",
  "versionCode": 100,
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
